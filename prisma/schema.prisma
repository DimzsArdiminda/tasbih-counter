generator client {
    provider = "prisma-client-js"
    // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  name                   String?
  password               String?
  photo                  String?
  emailVerified          DateTime?
  resetPasswordToken     String?   @unique
  resetPasswordExpires   DateTime?
  createdAt              DateTime  @default(now())

  accounts    Account[]
  sessions    Session[]
  dzikirs     Dzikir[]
  userDzikirs UserDzikir[]
  countTargets CountTarget[]
  dzikirHistories DzikirHistory[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Dzikir {
  id            String   @id @default(uuid())
  name          String
  arabic        String
  translation   String
  targetDefault Int
  createdAt     DateTime @default(now())
  userId        String?

  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userDzikirs  UserDzikir[]
}

model DzikirCount{
  id        String   @id @default(uuid())
  userId    String
  dzikirId  String
  count     Int      @default(0)
  createdAt DateTime @default(now())
}

model UserDzikir {
  id        String   @id @default(uuid())
  userId    String
  dzikirId  String
  count     Int      @default(0)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dzikir Dzikir @relation(fields: [dzikirId], references: [id], onDelete: Cascade)

  @@unique([userId, dzikirId])
}


model CountTarget {
  id        String   @id @default(uuid())
  target    Int      @default(0)
  createdAt DateTime @default(now())
  userId    String?
  user      User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DzikirHistory {
  id         String   @id @default(uuid())
  userId     String
  dhikrName  String
  count      Int
  target     Int
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum statusKitab {
  sahih
  hasan
  dhaif
}
model periawayat {
  id      String @id
  nama_kitab   String
  status  statusKitab @default(sahih) 
  createdAt DateTime @default(now())


  kitab musnad_darimi[]
  kitabA musnad_ahmad[]
  kitabS musnad_syafii[]
  kitabM muwatoh_malik[]
  kitabRA riyadhus_shalihin_arab[]
  kitabRS riyadhus_shalihin[]
  kitabB sahih_bukhori[]
  kitabMM sahih_muslim[]
  kitabAA sunan_abu_daud[]
  kitabIM sunan_ibnu_majah[]
  kitabSN sunan_nasai[]
  kitabST sunan_tirmidzi[]
}

model musnad_darimi{
  id String @id
  kitabId String 
  arab String @db.Text
  terjemah String @db.Text

  kitab periawayat @relation(fields: [kitabId], references: [id], onDelete: Cascade)
}

